NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=mysql://root:root@localhost:3306/bchealth
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=bchealth
DATABASE_USER=root
DATABASE_PASSWORD=

# Signing secrets. The placeholders below are rejected by validateEnvironment in
# production: they exist to show the shape of the value, not to be used. Generate
# a distinct pair with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
APPLICATION_LOG_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=2555
JWT_REFRESH_EXPIRES_IN=7d

# Password for the accounts created by `npm run prisma:seed`. If unset, the seed
# generates a random one and prints it once. Never commit a real value.
SEED_DEMO_PASSWORD=

THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Public URLs. Required and must be https in production.
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000

# Private documents are stored outside any publicly served directory.
PRIVATE_STORAGE_DRIVER=local
PRIVATE_STORAGE_ROOT=private-storage
PRIVATE_STORAGE_RETENTION_DAYS=0
