generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Sex {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum PatientType {
  STUDENT
  FACULTY
  STAFF
}

enum VisitStatus {
  OPEN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  APPROVED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentPriority {
  ROUTINE
  URGENT
  EMERGENCY
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  VACCINATION
  SCREENING
  CLEARANCE
  OTHER
}

enum RequirementStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum ClearanceStatus {
  PENDING
  INCOMPLETE
  FOR_REVIEW
  CLEARED
  REJECTED
  EXPIRED
}

enum EmergencyType {
  ILLNESS
  INJURY
  ALLERGIC_REACTION
  ASTHMA
  DIABETIC_EMERGENCY
  OTHER
}

enum Disposition {
  DISCHARGED
  ADMITTED
  REFERRED
  TRANSFERRED
  OBSERVATION
}

enum CertificateType {
  MEDICAL_CLEARANCE
  FITNESS_FOR_SCHOOL
  FITNESS_FOR_WORK
  VACCINATION_CERTIFICATE
  MEDICAL_EXEMPTION
  OTHER
}

enum SemesterTerm {
  FIRST
  SECOND
  SUMMER
}

enum ArchiveStatus {
  ACTIVE
  ARCHIVED
}

enum InventoryTransactionType {
  STOCK_IN
  ADJUSTMENT
  DISPENSE
  RETURNED
  EXPIRED
  DAMAGED
  LOST
}

enum NotificationType {
  SYSTEM
  APPOINTMENT
  REQUIREMENT
  CLEARANCE
  ANNOUNCEMENT
  OTHER
}

enum NotificationStatus {
  UNREAD
  READ
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  APPROVE
  REJECT
  DISPENSE
  EXPORT
  ARCHIVE
  RESTORE
  LIST_USERS
  VIEW_USER
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  ASSIGN_ROLE
  ROLE_CHANGE
  STATUS_CHANGE
  PASSWORD_CHANGE
  PASSWORD_RESET
  SIGNUP
  ACADEMIC_YEAR_CREATED
  SEMESTER_CREATED
  APPOINTMENT_CREATED
  APPOINTMENT_CHECKED_IN
  APPOINTMENT_STATUS_PENDING
  APPOINTMENT_STATUS_APPROVED
  APPOINTMENT_STATUS_CONFIRMED
  APPOINTMENT_STATUS_COMPLETED
  APPOINTMENT_STATUS_CANCELLED
  APPOINTMENT_STATUS_NO_SHOW
  APPOINTMENT_STATUS_RESCHEDULED
  CLEARANCE_CREATED
  CLEARANCE_PENDING
  CLEARANCE_INCOMPLETE
  CLEARANCE_FOR_REVIEW
  CLEARANCE_CLEARED
  CLEARANCE_REJECTED
  CLEARANCE_EXPIRED
  ANNOUNCEMENT_CREATED
  ANNOUNCEMENT_PUBLISHED
  MEDICINE_CREATED
  MEDICINE_STOCKED_IN
  MEDICINE_DISPENSED
  EMERGENCY_CASE_CREATED
  MEDICAL_CERTIFICATE_ISSUED
  VACCINATION_RECORDED
  HEALTH_SCREENING_RECORDED
  VISIT_CREATED
  VISIT_VITAL_SIGNS_RECORDED
  VISIT_CONSULTATION_RECORDED
  VISIT_STATUS_OPEN
  VISIT_STATUS_IN_CONSULTATION
  VISIT_STATUS_COMPLETED
  VISIT_STATUS_CANCELLED
  PATIENT_ARCHIVED
  PATIENT_RESTORED
  PATIENT_EMERGENCY_CONTACT_ADDED
  PATIENT_HISTORY_ADDED
  PATIENT_CONDITION_ADDED
  PATIENT_ALLERGY_ADDED
  REQUIREMENT_CREATED
  REQUIREMENT_SUBMITTED
  REQUIREMENT_NOT_SUBMITTED
  REQUIREMENT_UNDER_REVIEW
  REQUIREMENT_VERIFIED
  REQUIREMENT_REJECTED
  REQUIREMENT_EXPIRED
  OTHER
}

model User {
  id                    String                  @id @default(uuid())
  email                 String                  @unique
  passwordHash          String
  displayName           String
  registrationProfile   Json?
  status                UserStatus              @default(ACTIVE)
  emailVerifiedAt       DateTime?
  emailVerificationTokenHash String?            @unique
  emailVerificationExpiresAt DateTime?
  patientId             String?                 @unique
  patient               Patient?                @relation(fields: [patientId], references: [id])
  roles                 UserRole[]
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  assignedAppointments  Appointment[]
  clinicalVisits        ClinicVisit[]
  consultations         Consultation[]
  vitalSigns            VitalSign[]
  requirementReviews    RequirementSubmission[]
  issuedClearances      Clearance[]
  vaccinationsGiven     VaccinationRecord[]
  screeningsPerformed   HealthScreening[]
  dispensations         MedicineDispensation[]
  certificatesIssued    MedicalCertificate[]
  documentsCreated      Document[]
  announcementsCreated  Announcement[]
  inventoryTransactions InventoryTransaction[]
  emergencyAttended     EmergencyCase[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?
  notifications         Notification[]
  archives              Archive[]

  @@index([displayName])
  @@index([status])
  @@index([deletedAt])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String      @id @default(uuid())
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([entity, entityId, createdAt])
}

model Patient {
  id                String                  @id @default(uuid())
  patientNumber     String                  @unique
  type              PatientType
  firstName         String
  middleName        String?
  lastName          String
  suffix            String?
  email             String?                 @unique
  phone             String?
  birthDate         DateTime?
  sex               Sex?
  address           String?
  studentProfile    StudentProfile?
  employeeProfile   EmployeeProfile?
  user              User?
  emergencyContacts EmergencyContact[]
  medicalHistories  MedicalHistory[]
  conditions        MedicalCondition[]
  allergies         Allergy[]
  visits            ClinicVisit[]
  appointments      Appointment[]
  submissions       RequirementSubmission[]
  clearances        Clearance[]
  vaccinations      VaccinationRecord[]
  screenings        HealthScreening[]
  emergencyCases    EmergencyCase[]
  dispensations     MedicineDispensation[]
  certificates      MedicalCertificate[]
  documents         Document[]
  healthRecord      PatientHealthRecord?
  archiveStatus     ArchiveStatus           @default(ACTIVE)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?

  @@index([lastName, firstName])
  @@index([type])
}

/// Structured digital counterpart of the clinic's two-page paper health record.
/// JSON sections keep the original checklist answers and remarks while allowing
/// the form to evolve without adding a database column for every paper field.
model PatientHealthRecord {
  id                     String   @id @default(uuid())
  patientId              String   @unique
  patient                Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  guardianName           String?
  spouseName             String?
  nationality            String?
  doctorOfChoice         String?
  hospitalOfChoice       String?
  presentHistory         String?  @db.Text
  reviewOfSystems        String?  @db.Text
  pastMedicalHistory     Json?
  obGyneHistory          Json?
  familyHistory          Json?
  psychosocialHistory    Json?
  physicalExamination    Json?
  laboratoryExaminations Json?
  updatedById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([updatedAt])
}

model PatientNumberSequence {
  year      Int @id
  lastValue Int
}

model StudentProfile {
  id        String  @id @default(uuid())
  patientId String  @unique
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  studentId String  @unique
  program   String
  yearLevel Int?
  section   String?

  @@index([program])
}

model EmployeeProfile {
  id         String  @id @default(uuid())
  patientId  String  @unique
  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  employeeId String  @unique
  department String
  position   String?
}

model EmergencyContact {
  id           String   @id @default(uuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  address      String?
  createdAt    DateTime @default(now())
}

model MedicalHistory {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  summary    String
  notes      String?
  recordedAt DateTime @default(now())
  isActive   Boolean  @default(true)
}

model MedicalCondition {
  id          String    @id @default(uuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name        String
  diagnosedAt DateTime?
  resolvedAt  DateTime?
  notes       String?
  isActive    Boolean   @default(true)

  @@index([name])
}

model Allergy {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergen  String
  reaction  String?
  severity  String?
  notes     String?
  isActive  Boolean @default(true)

  @@index([allergen])
}

model AcademicYear {
  id           String              @id @default(uuid())
  label        String              @unique
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean             @default(false)
  semesters    Semester[]
  requirements HealthRequirement[]
  clearances   Clearance[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Semester {
  id             String              @id @default(uuid())
  academicYearId String
  academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term           SemesterTerm
  label          String
  startsAt       DateTime
  endsAt         DateTime
  isActive       Boolean             @default(false)
  requirements   HealthRequirement[]
  clearances     Clearance[]

  @@unique([academicYearId, term])
}

model ClinicVisit {
  id                    String                 @id @default(uuid())
  patientId             String
  patient               Patient                @relation(fields: [patientId], references: [id])
  clinicianId           String?
  clinician             User?                  @relation(fields: [clinicianId], references: [id])
  visitDate             DateTime               @default(now())
  queueNumber           Int?
  chiefComplaint        String?
  status                VisitStatus            @default(OPEN)
  notes                 String?
  vitalSigns            VitalSign[]
  consultations         Consultation[]
  emergencyCases        EmergencyCase[]
  archiveStatus         ArchiveStatus          @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  medicineDispensations MedicineDispensation[]

  @@index([patientId, visitDate])
  @@index([visitDate])
  @@index([queueNumber])
}

model VitalSign {
  id               String      @id @default(uuid())
  clinicVisitId    String
  clinicVisit      ClinicVisit @relation(fields: [clinicVisitId], references: [id], onDelete: Cascade)
  recordedById     String?
  recordedBy       User?       @relation(fields: [recordedById], references: [id])
  temperatureC     Decimal?    @db.Decimal(4, 1)
  systolicBp       Int?
  diastolicBp      Int?
  pulseRate        Int?
  respiratoryRate  Int?
  oxygenSaturation Int?
  heightCm         Decimal?    @db.Decimal(5, 2)
  weightKg         Decimal?    @db.Decimal(5, 2)
  recordedAt       DateTime    @default(now())
}

model Consultation {
  id            String         @id @default(uuid())
  clinicVisitId String
  clinicVisit   ClinicVisit    @relation(fields: [clinicVisitId], references: [id], onDelete: Cascade)
  clinicianId   String?
  clinician     User?          @relation(fields: [clinicianId], references: [id])
  subjective    String?
  objective     String?
  assessment    String?
  plan          String?
  cues          String?        @db.Text
  nursingDiagnosis String?     @db.Text
  nursingIntervention String?  @db.Text
  medicalDiagnosis String?     @db.Text
  medicalIntervention String?  @db.Text
  evaluation    String?        @db.Text
  diagnoses     Diagnosis[]
  treatments    Treatment[]
  prescriptions Prescription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Diagnosis {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  code           String?
  description    String
  notes          String?
  createdAt      DateTime     @default(now())
}

model Treatment {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  description    String
  notes          String?
  createdAt      DateTime     @default(now())
}

model Prescription {
  id             String             @id @default(uuid())
  consultationId String
  consultation   Consultation       @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  instructions   String?
  items          PrescriptionItem[]
  createdAt      DateTime           @default(now())
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName   String
  dosage         String
  frequency      String
  duration       String?
  quantity       Int?
}

model Appointment {
  id                 String              @id @default(uuid())
  patientId          String
  patient            Patient             @relation(fields: [patientId], references: [id])
  assignedToId       String?
  assignedTo         User?               @relation(fields: [assignedToId], references: [id])
  scheduledAt        DateTime
  durationMins       Int                 @default(30)
  purpose            String
  type               AppointmentType     @default(CONSULTATION)
  priority           AppointmentPriority @default(ROUTINE)
  status             AppointmentStatus   @default(PENDING)
  notes              String?
  cancellationReason String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([scheduledAt])
  @@index([patientId, scheduledAt])
}

model HealthRequirement {
  id             String                  @id @default(uuid())
  name           String
  description    String?
  applicableTo   String
  academicYearId String
  academicYear   AcademicYear            @relation(fields: [academicYearId], references: [id])
  semesterId     String?
  semester       Semester?               @relation(fields: [semesterId], references: [id])
  deadline       DateTime?
  submissions    RequirementSubmission[]
  archiveStatus  ArchiveStatus           @default(ACTIVE)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([academicYearId, semesterId])
}

model RequirementSubmission {
  id            String            @id @default(uuid())
  requirementId String
  requirement   HealthRequirement @relation(fields: [requirementId], references: [id])
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id])
  documentId    String?
  document      Document?         @relation(fields: [documentId], references: [id])
  status        RequirementStatus @default(SUBMITTED)
  submittedAt   DateTime          @default(now())
  reviewedAt    DateTime?
  reviewerId    String?
  reviewer      User?             @relation(fields: [reviewerId], references: [id])
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([requirementId, patientId])
  @@index([status])
}

model Clearance {
  id             String          @id @default(uuid())
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id])
  type           String
  academicYearId String
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])
  semesterId     String?
  semester       Semester?       @relation(fields: [semesterId], references: [id])
  status         ClearanceStatus @default(PENDING)
  remarks        String?
  issuedById     String?
  issuedBy       User?           @relation(fields: [issuedById], references: [id])
  issuedAt       DateTime?
  expiresAt      DateTime?
  archiveStatus  ArchiveStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([patientId, status])
  @@index([academicYearId, semesterId])
}

model VaccinationRecord {
  id               String    @id @default(uuid())
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id])
  vaccineName      String
  dose             String
  administeredAt   DateTime
  manufacturer     String?
  lotNumber        String?
  administeredById String?
  administeredBy   User?     @relation(fields: [administeredById], references: [id])
  remarks          String?
  nextDoseAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([patientId, administeredAt])
}

model HealthScreening {
  id              String   @id @default(uuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  screeningType   String
  screenedAt      DateTime
  result          String
  findings        String?
  recommendations String?
  screenedById    String?
  screenedBy      User?    @relation(fields: [screenedById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([screenedAt])
}

model Medicine {
  id           String          @id @default(uuid())
  name         String
  genericName  String?
  brand        String?
  dosageForm   String
  unit         String
  reorderLevel Int             @default(0)
  batches      MedicineBatch[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?

  @@index([name])
  @@index([genericName])
}

model MedicineBatch {
  id                String                     @id @default(uuid())
  medicineId        String
  medicine          Medicine                   @relation(fields: [medicineId], references: [id])
  batchNumber       String
  expiresAt         DateTime
  quantity          Int                        @default(0)
  supplier          String?
  transactions      InventoryTransaction[]
  dispensationItems MedicineDispensationItem[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([medicineId, batchNumber])
  @@index([expiresAt])
}

model InventoryTransaction {
  id              String                   @id @default(uuid())
  medicineBatchId String
  medicineBatch   MedicineBatch            @relation(fields: [medicineBatchId], references: [id])
  type            InventoryTransactionType
  quantity        Int
  reason          String?
  actorId         String?
  actor           User?                    @relation(fields: [actorId], references: [id])
  createdAt       DateTime                 @default(now())

  @@index([type, createdAt])
}

model MedicineDispensation {
  id            String                     @id @default(uuid())
  patientId     String
  patient       Patient                    @relation(fields: [patientId], references: [id])
  clinicVisitId String?
  clinicVisit   ClinicVisit?               @relation(fields: [clinicVisitId], references: [id], onDelete: SetNull)
  dispensedById String?
  dispensedBy   User?                      @relation(fields: [dispensedById], references: [id])
  items         MedicineDispensationItem[]
  notes         String?
  createdAt     DateTime                   @default(now())
}

model MedicineDispensationItem {
  id              String               @id @default(uuid())
  dispensationId  String
  dispensation    MedicineDispensation @relation(fields: [dispensationId], references: [id], onDelete: Cascade)
  medicineBatchId String
  medicineBatch   MedicineBatch        @relation(fields: [medicineBatchId], references: [id])
  quantity        Int
  instructions    String?
}

model EmergencyCase {
  id            String        @id @default(uuid())
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  clinicVisitId String?
  clinicVisit   ClinicVisit?  @relation(fields: [clinicVisitId], references: [id], onDelete: SetNull)
  occurredAt    DateTime
  emergencyType EmergencyType
  description   String
  actionTaken   String
  treatment     String?
  disposition   Disposition?
  attendedById  String?
  attendedBy    User?         @relation(fields: [attendedById], references: [id])
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([occurredAt])
}

model MedicalCertificate {
  id         String          @id @default(uuid())
  patientId  String
  patient    Patient         @relation(fields: [patientId], references: [id])
  type       CertificateType
  purpose    String
  issuedAt   DateTime        @default(now())
  validUntil DateTime?
  issuedById String?
  issuedBy   User?           @relation(fields: [issuedById], references: [id])
  remarks    String?
  findings   String?          @db.Text
  fitnessStatus String?
  recommendations String?    @db.Text
  followUpAt DateTime?
  referredTo String?
  confinementType String?
  confinementFrom DateTime?
  confinementUntil DateTime?
  physicianName String?
  physicianLicenseNo String?
  physicianPtrNo String?
  physicianContact String?
  requiredImmunizations Json?
  documentId String?         @unique
  document   Document?       @relation(fields: [documentId], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Document {
  id          String                  @id @default(uuid())
  patientId   String?
  patient     Patient?                @relation(fields: [patientId], references: [id])
  filename    String
  mimeType    String
  storageKey  String
  sizeBytes   Int
  isPrivate   Boolean                 @default(true)
  submissions RequirementSubmission[]
  certificate MedicalCertificate?
  createdById String?
  createdBy   User?                   @relation(fields: [createdById], references: [id])
  createdAt   DateTime                @default(now())

  @@index([patientId])
}

model Notification {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      NotificationType
  status    NotificationStatus @default(UNREAD)
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([userId, status])
}

model Announcement {
  id          String        @id @default(uuid())
  title       String
  body        String
  audience    String
  status      ArchiveStatus @default(ACTIVE)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Archive {
  id             String    @id @default(uuid())
  recordType     String
  recordId       String
  data           Json
  archivedBy     String?
  archivedByUser User?     @relation(fields: [archivedBy], references: [id])
  archivedAt     DateTime  @default(now())
  restoredAt     DateTime?
  reason         String?
  createdAt      DateTime  @default(now())

  @@index([recordType, recordId])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
