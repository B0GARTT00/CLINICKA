DATABASE_URL="mysql://bchealth:bchealth@localhost:3306/bchealth"

# Signing secrets. Generate a distinct pair with `openssl rand -base64 48`; both
# values are rejected at startup if they are placeholders, too short, or equal
# to one another. See docs/security.md.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
APPLICATION_LOG_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=2555
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

NODE_ENV=development
SEED_DEMO_PASSWORD=""

FRONTEND_URL="http://localhost:5173"
PUBLIC_API_URL="http://localhost:3000/api"
CORS_ORIGIN="http://localhost:5173"

PORT=3000
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
PRIVATE_STORAGE_DRIVER="local"
PRIVATE_STORAGE_ROOT="private-storage"
PRIVATE_STORAGE_RETENTION_DAYS=0
