{
  "name": "clinicka",
  "private": true,
  "version": "0.1.0",
  "description": "BCHealth clinic information and records management system.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "gen-jwt": "powershell -ExecutionPolicy Bypass -File scripts/gen-jwt.ps1",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "dev": "concurrently \"npm run dev --workspace @clinicka/api\" \"npm run dev --workspace @clinicka/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @clinicka/api",
    "test:frontend": "npm run test --workspace @clinicka/web",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "globals": "^15.14.0",
    "mysql2": "^3.24.3",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "prisma-erd-generator": "^3.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "overrides": {
    "rxjs": "7.8.2"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^5.1.1"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
